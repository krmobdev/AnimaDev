<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries><package android:name="com.termux" /></queries>
    <application android:label="AnimaDev" android:icon="@drawable/ic_launcher"
        android:allowBackup="false" android:supportsRtl="true" android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".repos.RepoResultReceiver" android:exported="false" />
        <receiver android:name=".termux.ProbeResultReceiver" android:exported="false" />
    </application>
</manifest>
