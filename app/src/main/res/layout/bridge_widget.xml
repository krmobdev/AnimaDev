<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bridge_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bridge_widget_background"
    android:padding="12dp"
    android:orientation="vertical">
    <TextView android:id="@+id/bridge_widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/bridge_widget_title"
        android:textStyle="bold" android:textSize="19sp" android:textColor="#EAFDF3"
        android:clickable="true" />
    <TextView android:id="@+id/bridge_widget_state" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/bridge_unknown"
        android:textSize="14sp" android:textColor="#F5CD8E" android:paddingTop="4dp" />
    <LinearLayout android:id="@+id/bridge_widget_details" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingTop="6dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/bridge_server_unverified" android:textColor="#BDCAC6"
            android:textSize="12sp" />
        <TextView android:id="@+id/bridge_widget_autostart" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#BDCAC6" android:textSize="12sp" />
        <TextView android:id="@+id/bridge_widget_checked" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#BDCAC6" android:textSize="12sp" />
        <TextView android:id="@+id/bridge_widget_feedback" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#BDCAC6" android:textSize="12sp"
            android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center"
        android:paddingTop="8dp">
        <Button android:id="@+id/bridge_widget_start" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:textAllCaps="false"
            android:textSize="11sp" android:text="@string/bridge_start" />
        <Button android:id="@+id/bridge_widget_stop" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:textAllCaps="false"
            android:textSize="11sp" android:text="@string/bridge_stop" />
        <Button android:id="@+id/bridge_widget_restart" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:textAllCaps="false"
            android:textSize="11sp" android:text="@string/bridge_restart" />
        <Button android:id="@+id/bridge_widget_check" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:textAllCaps="false"
            android:textSize="11sp" android:text="@string/bridge_check" />
    </LinearLayout>
</LinearLayout>
