<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
 android:gravity="center_vertical" android:orientation="vertical"
 android:padding="6dp" android:background="@drawable/bridge_widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="21dp"
 android:gravity="center_vertical" android:orientation="horizontal">
 <ImageView android:layout_width="23dp" android:layout_height="23dp"
  android:src="@drawable/ic_bridge_tile" android:tint="#7EF5AA" android:contentDescription="@null"/>
 <TextView android:id="@+id/bridge_widget_title" android:layout_width="0dp"
  android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical"
  android:paddingStart="7dp" android:fontFamily="sans-serif-medium" android:textSize="16sp"
  android:textColor="#F3FFF8" android:text="@string/bridge_widget_title" android:clickable="true"/>
 <TextView android:id="@+id/bridge_widget_dot" android:layout_width="wrap_content"
  android:layout_height="wrap_content" android:text="●" android:textSize="12sp"
  android:paddingEnd="4dp" android:textColor="#7EF5AA"/>
 <TextView android:id="@+id/bridge_widget_pill" android:layout_width="wrap_content"
  android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#7EF5AA"
  android:text="@string/bridge_unknown" android:fontFamily="sans-serif-medium"/>
</LinearLayout>
<TextView android:id="@+id/bridge_widget_state" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="2dp" android:textSize="15sp" android:textColor="#7EF5AA"
 android:singleLine="true" android:ellipsize="end" android:fontFamily="sans-serif-medium"
 android:text="@string/bridge_unknown"/>
<TextView android:id="@+id/bridge_widget_summary"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="1dp" android:textSize="10sp"
 android:textColor="#B4D7C3" android:singleLine="true"
 android:ellipsize="end" android:text="@string/bridge_widget_compact_summary_placeholder"/>
<TextView android:id="@+id/bridge_widget_checked" android:layout_width="match_parent"
 android:layout_height="wrap_content" android:layout_marginTop="1dp"
 android:textColor="#A8BEB0" android:textSize="10sp" android:singleLine="true"
 android:text="@string/bridge_widget_checked_short"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginTop="3dp" android:orientation="horizontal"><FrameLayout android:id="@+id/bridge_widget_start" android:layout_width="0dp"
 android:layout_height="30dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:clickable="true">
 <ImageView android:id="@+id/bridge_widget_start_bg" android:layout_width="match_parent"
  android:layout_height="match_parent" android:src="@drawable/bridge_widget_action_secondary"
  android:scaleType="fitXY" android:contentDescription="@null"/>
 <TextView android:id="@+id/bridge_widget_start_text" android:layout_width="match_parent"
  android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif-medium"
  android:textSize="11sp" android:textColor="#F3FFF8" android:text="@string/bridge_start"/>
</FrameLayout>
<FrameLayout android:id="@+id/bridge_widget_stop" android:layout_width="0dp"
 android:layout_height="30dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:clickable="true">
 <ImageView android:id="@+id/bridge_widget_stop_bg" android:layout_width="match_parent"
  android:layout_height="match_parent" android:src="@drawable/bridge_widget_action_secondary"
  android:scaleType="fitXY" android:contentDescription="@null"/>
 <TextView android:id="@+id/bridge_widget_stop_text" android:layout_width="match_parent"
  android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif-medium"
  android:textSize="11sp" android:textColor="#F3FFF8" android:text="@string/bridge_stop"/>
</FrameLayout>
<FrameLayout android:id="@+id/bridge_widget_check" android:layout_width="0dp"
 android:layout_height="30dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:clickable="true">
 <ImageView android:id="@+id/bridge_widget_check_bg" android:layout_width="match_parent"
  android:layout_height="match_parent" android:src="@drawable/bridge_widget_action_secondary"
  android:scaleType="fitXY" android:contentDescription="@null"/>
 <TextView android:id="@+id/bridge_widget_check_text" android:layout_width="match_parent"
  android:layout_height="match_parent" android:gravity="center" android:fontFamily="sans-serif-medium"
  android:textSize="11sp" android:textColor="#F3FFF8" android:text="@string/bridge_check"/>
</FrameLayout></LinearLayout>
</LinearLayout>
